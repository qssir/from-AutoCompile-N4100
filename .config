# Intel N4100 x86_64 专属硬件架构优化
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=geminilake"

# 安全扩容对齐：设置 2GB 豪华固件根分区 (2048MB)
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# 🛡️ 净化开发工具链：坚决断绝 Python 编译死循环
# 显式取消所有可能引入 python 源码本地编译的非必要包
#CONFIG_PACKAGE_python3 is not set
#CONFIG_PACKAGE_python3-base is not set

# 🚀 核心底层要素：FUSE 挂载与存储驱动 (解决 AList 无法挂载硬伤)
CONFIG_PACKAGE_fuse-utils=y
CONFIG_PACKAGE_libfuse=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# 📦 Docker 运行环境集成 (完美释放 8G 内存潜能)
CONFIG_PACKAGE_docker-ce=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y

# 🎬 影音聚合与存储 (AList、Samba4、下载全家桶)
CONFIG_PACKAGE_luci-app-alist=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-app-transmission=y

# 🔥 网络代理与高性能 eBPF 特性 (DAED 传统经典对齐)
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_kmod-xdp=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_libbpf=y

# 🌐 传统经典代理服务与依赖对齐
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall=y

# 🛡️ VPN 与异地组网菜单
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-tailscale=y

# ⚡ 网络菜单增强包 (接口与流量控制)
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-flowoffload=y

# 🛠️ 系统与维护增强 (磁盘与文件管理)
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_shared-bindmount=y
